//@version=6
// FX NEXT v5 — cost-gated direction call with on-chart triple-barrier scoreboard
// Display layer for the FX NEXT research stack (docs/FX_NEXT_architecture.md, rev 3).
// It does not prove an edge. It stops you trading where no edge can survive cost,
// and it keeps an honest spread-aware, financing-aware score of its own calls.
indicator("FX NEXT v5 — cost-gated call", "FXNEXT v5", overlay=true, max_lines_count=100, max_labels_count=50)

// ───────────────────────────── inputs ─────────────────────────────
grpCost = "Cost model"
spreadPips   = input.float(1.2, "Round-trip spread (pips)", minval=0.0, step=0.1, group=grpCost,
     tooltip="TradingView has no bid/ask. Enter your broker's typical spread for this pair. OANDA US spread-only published: EURUSD 1.4, USDJPY 1.4, GBPUSD 2.0, GBPJPY 3.1, AUDUSD 1.4, USDCHF 1.8, NZDUSD 1.7, EURGBP 1.7.")
pipOverride  = input.float(0.0, "Pip size (0 = auto from mintick × 10)", minval=0.0, step=0.0001, group=grpCost)
adminFeePct  = input.float(1.0, "Financing admin fee (% p.a., charged each side)", minval=0.0, step=0.25, group=grpCost)
useCarryGate = input.bool(true, "Charge expected financing inside the cost gate", group=grpCost)
costMax1h    = input.float(0.09, "Max cost / ATR at 1h", minval=0.0, step=0.01, group=grpCost)
costMaxHi    = input.float(0.06, "Max cost / ATR at 4h and D1", minval=0.0, step=0.01, group=grpCost)

grpLab = "Barriers"
kATR   = input.float(1.0, "Barrier k (× ATR)", minval=0.25, step=0.25, group=grpLab)
hBars  = input.int(4, "Time stop H (bars)", minval=1, group=grpLab)
atrLen = input.int(14, "ATR length", minval=2, group=grpLab)

grpSig = "Direction score"
minScore   = input.int(4, "Min |score| to call (score range −6…6)", minval=1, maxval=6, group=grpSig)
requireHTF = input.bool(true, "Block calls the higher timeframe opposes", group=grpSig)

grpSess = "Entry-time exclusions (New York time unless stated)"
useSess         = input.bool(true, "Only London 08:00–16:30 or New York 08:00–17:00 (local time)", group=grpSess)
excludeReleases = input.bool(true, "Exclude 08:25–08:45, 09:55–10:15, 13:55–14:30 (release slots)", group=grpSess)
excludeRoll     = input.bool(true, "Exclude 16:30–17:30 (daily close and reopen)", group=grpSess)
excludeThin     = input.bool(true, "Exclude 22 Dec – 2 Jan", group=grpSess)

grpBoard = "Scoreboard"
minCallsForVerdict = input.int(200, "Calls needed before a verdict is shown", minval=20, group=grpBoard)
showBoard          = input.bool(true, "Show scoreboard", group=grpBoard)

// ───────────────────────────── timeframe ─────────────────────────────
tfSec    = timeframe.in_seconds()
barHours = tfSec / 3600.0
is1h     = tfSec == 3600
is4h     = tfSec == 14400
isD      = timeframe.isdaily
tfOK     = is1h or is4h or isD
htf      = is1h ? "240" : is4h ? "D" : "W"
costMax  = is1h ? costMax1h : costMaxHi

// ───────────────────────────── cost model ─────────────────────────────
pip  = pipOverride > 0 ? pipOverride : syminfo.mintick * 10
spr  = spreadPips * pip
atr  = ta.atr(atrLen)

// policy rates from TradingView Economics (e.g. ECONOMICS:USINTR); na if the symbol is missing
baseRate  = request.security("ECONOMICS:" + syminfo.basecurrency + "INTR", "D", close, ignore_invalid_symbol=true)
quoteRate = request.security("ECONOMICS:" + syminfo.currency + "INTR", "D", close, ignore_invalid_symbol=true)
carryOK   = not na(baseRate) and not na(quoteRate)
float carry = carryOK ? baseRate - quoteRate : na          // % p.a. a long earns before fees

// pips per night, positive = received, negative = paid; price × rate/365 in quote currency per unit, then in pips
longRatePct  = carryOK ? carry - adminFeePct : 0.0
shortRatePct = carryOK ? -carry - adminFeePct : 0.0
finLongPips  = close * (longRatePct / 100.0) / 365.0 / pip
finShortPips = close * (shortRatePct / 100.0) / 365.0 / pip

// expected nights charged over the hold (D1 carries the Wednesday triple roll as ×1.4)
nightsHeld = isD ? hBars * 1.4 : hBars * barHours / 24.0

finCostLong  = useCarryGate ? math.max(0.0, -finLongPips) * nightsHeld * pip : 0.0
finCostShort = useCarryGate ? math.max(0.0, -finShortPips) * nightsHeld * pip : 0.0
cLong  = (spr + finCostLong) / atr
cShort = (spr + finCostShort) / atr
costOKLong  = cLong <= costMax
costOKShort = cShort <= costMax

// ───────────────────────────── direction score ─────────────────────────────
e8  = ta.ema(close, 8)
e21 = ta.ema(close, 21)
e55 = ta.ema(close, 55)
trendScore = (close > e8 ? 1 : -1) + (e8 > e21 ? 1 : -1) + (e21 > e55 ? 1 : -1)
hh = ta.highest(high, 20)
ll = ta.lowest(low, 20)
rp = (close - ll) / math.max(hh - ll, syminfo.mintick)
rpScore  = rp > 0.7 ? 1 : rp < 0.3 ? -1 : 0
rsiV     = ta.rsi(close, 14)
rsiScore = rsiV > 55 ? 1 : rsiV < 45 ? -1 : 0
slope      = e21 - e21[3]
slopeScore = slope > 0 ? 1 : slope < 0 ? -1 : 0
score = trendScore + rpScore + rsiScore + slopeScore

// higher timeframe: last COMPLETED bar only (value[1] with lookahead_on is the non-repainting idiom)
htfE21  = request.security(syminfo.tickerid, htf, ta.ema(close, 21)[1], lookahead=barmerge.lookahead_on)
htfE21p = request.security(syminfo.tickerid, htf, ta.ema(close, 21)[4], lookahead=barmerge.lookahead_on)
htfTrend = htfE21 > htfE21p ? 1 : htfE21 < htfE21p ? -1 : 0
htfOKLong  = not requireHTF or htfTrend >= 0
htfOKShort = not requireHTF or htfTrend <= 0

// ───────────────────────────── entry-time exclusions ─────────────────────────────
// the call is made at bar close and entered on the next bar, so exclusions use the bar's close time
nyMin  = hour(time_close, "America/New_York") * 60 + minute(time_close, "America/New_York")
lonMin = hour(time_close, "Europe/London") * 60 + minute(time_close, "Europe/London")
inLondon = lonMin >= 8 * 60 and lonMin < 16 * 60 + 30
inNY     = nyMin >= 8 * 60 and nyMin < 17 * 60
inRel    = (nyMin >= 8 * 60 + 25 and nyMin < 8 * 60 + 45) or (nyMin >= 9 * 60 + 55 and nyMin < 10 * 60 + 15) or (nyMin >= 13 * 60 + 55 and nyMin < 14 * 60 + 30)
inRoll   = nyMin >= 16 * 60 + 30 and nyMin < 17 * 60 + 30
mo = month(time_close, "America/New_York")
dm = dayofmonth(time_close, "America/New_York")
thin = (mo == 12 and dm >= 22) or (mo == 1 and dm <= 2)

sessOK = isD or not useSess or inLondon or inNY
relOK  = isD or not excludeReleases or not inRel
rollOK = isD or not excludeRoll or not inRoll
thinOK = not excludeThin or not thin
timeOK = sessOK and relOK and rollOK and thinOK

// ───────────────────────────── the gated call ─────────────────────────────
rawLong  = score >= minScore
rawShort = score <= -minScore
longCall  = tfOK and rawLong and htfOKLong and timeOK and costOKLong and barstate.isconfirmed
shortCall = tfOK and rawShort and htfOKShort and timeOK and costOKShort and barstate.isconfirmed
// why a raw signal was blocked (for the board)
blockedLong  = tfOK and rawLong and not longCall
blockedShort = tfOK and rawShort and not shortCall

// ───────────────────────────── scoreboard: spread-aware triple barrier on own calls ─────────────────────────────
var array<int>   oDir   = array.new<int>()     // +1 long, −1 short
var array<float> oEntry = array.new<float>()   // na until filled at next bar's open
var array<int>   oBar   = array.new<int>()     // entry bar index
var array<float> oAtr   = array.new<float>()   // ATR at call
var array<float> oCost  = array.new<float>()   // c at call (for the break-even line)
var array<float> oFin   = array.new<float>()   // financing pips per night, signed for the call direction

var int   nCalls    = 0
var int   nResolved = 0   // barrier hits
var int   nWins     = 0   // favourable barrier first
var int   nTime     = 0   // time stops
var float pnlAtrSum = 0.0 // net P&L in ATR units, spread and financing included
var float costSum   = 0.0

// 1) fill pending entries at this bar's open (close + measured latency in the stack; the open is the Pine stand-in)
if array.size(oDir) > 0
    for i = 0 to array.size(oDir) - 1
        if na(array.get(oEntry, i))
            d = array.get(oDir, i)
            array.set(oEntry, i, d == 1 ? open + spr / 2 : open - spr / 2)
            array.set(oBar, i, bar_index)

// 2) resolve open calls against this bar's range, exit side priced on the exit quote
if array.size(oDir) > 0
    for i = array.size(oDir) - 1 to 0
        e = array.get(oEntry, i)
        if not na(e)
            d   = array.get(oDir, i)
            a   = array.get(oAtr, i)
            eb  = array.get(oBar, i)
            fpn = array.get(oFin, i)
            held = bar_index - eb + 1
            nights = isD ? held * 1.4 : held * barHours / 24.0
            finPx = fpn * nights * pip
            float exitPx = na
            int outcome = 0            // +1 win barrier, −1 loss barrier, 0 time stop
            bool done = false
            if d == 1
                upHit = high - spr / 2 >= e + kATR * a
                dnHit = low  - spr / 2 <= e - kATR * a
                if dnHit                                   // stop assumed first when both lie inside one bar
                    exitPx := e - kATR * a
                    outcome := -1
                    done := true
                else if upHit
                    exitPx := e + kATR * a
                    outcome := 1
                    done := true
                else if held >= hBars
                    exitPx := close - spr / 2
                    outcome := 0
                    done := true
            else
                dnHit = low  + spr / 2 <= e - kATR * a
                upHit = high + spr / 2 >= e + kATR * a
                if upHit
                    exitPx := e + kATR * a
                    outcome := -1
                    done := true
                else if dnHit
                    exitPx := e - kATR * a
                    outcome := 1
                    done := true
                else if held >= hBars
                    exitPx := close + spr / 2
                    outcome := 0
                    done := true
            if done
                pnlPx = (d == 1 ? exitPx - e : e - exitPx) + finPx
                pnlAtrSum += pnlPx / a
                if outcome == 0
                    nTime += 1
                else
                    nResolved += 1
                    if outcome == 1
                        nWins += 1
                array.remove(oDir, i)
                array.remove(oEntry, i)
                array.remove(oBar, i)
                array.remove(oAtr, i)
                array.remove(oCost, i)
                array.remove(oFin, i)

// 3) register this bar's call (entered next bar)
if longCall or shortCall
    d = longCall ? 1 : -1
    array.push(oDir, d)
    array.push(oEntry, float(na))
    array.push(oBar, bar_index)
    array.push(oAtr, atr)
    array.push(oCost, longCall ? cLong : cShort)
    array.push(oFin, longCall ? finLongPips : finShortPips)
    nCalls += 1
    costSum += longCall ? cLong : cShort
    // barrier guide lines around this close (entry is next open, so these are approximate)
    upB = close + kATR * atr
    dnB = close - kATR * atr
    line.new(bar_index + 1, upB, bar_index + 1 + hBars, upB, color=longCall ? color.new(color.green, 0) : color.new(color.red, 0), width=1)
    line.new(bar_index + 1, dnB, bar_index + 1 + hBars, dnB, color=longCall ? color.new(color.red, 0) : color.new(color.green, 0), width=1)

// ───────────────────────────── statistics ─────────────────────────────
wilsonLow(float w, float n) =>
    float out = na
    if n > 0
        z = 1.96
        p = w / n
        den = 1 + z * z / n
        ctr = p + z * z / (2 * n)
        sp  = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n))
        out := (ctr - sp) / den
    out

nClosed    = nResolved + nTime
q          = nClosed > 0 ? nResolved / float(nClosed) : na
cAvg       = nCalls > 0 ? costSum / nCalls : na
pStar      = not na(q) and q > 0 ? 0.5 + cAvg / (2 * kATR * q) : na
hitRate    = nResolved > 0 ? nWins / float(nResolved) : na
hitLow     = wilsonLow(nWins, nResolved)
expectancy = nClosed > 0 ? pnlAtrSum / nClosed : na
verdictReady = nClosed >= minCallsForVerdict
edgeShown    = verdictReady and not na(hitLow) and not na(pStar) and hitLow > pStar and expectancy > 0

// ───────────────────────────── drawing ─────────────────────────────
plotshape(longCall,  title="Long call",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.small)
plotshape(shortCall, title="Short call", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0),   size=size.small)
plotshape(blockedLong,  title="Long blocked",  style=shape.circle, location=location.belowbar, color=color.new(color.gray, 40), size=size.tiny)
plotshape(blockedShort, title="Short blocked", style=shape.circle, location=location.abovebar, color=color.new(color.gray, 40), size=size.tiny)
bgcolor(tfOK and not costOKLong and not costOKShort ? color.new(color.red, 92) : na, title="Cost wall (both directions fail)")
bgcolor(not tfOK ? color.new(color.gray, 94) : na, title="Untraded timeframe")

var table board = table.new(position.top_right, 2, 15, border_width=1, frame_color=color.new(color.gray, 60), border_color=color.new(color.gray, 80))
f3(float x) => na(x) ? "n/a" : str.tostring(x, "#.###")
pct(float x) => na(x) ? "n/a" : str.tostring(x * 100, "#.#") + "%"
signed(float x) => not carryOK ? "n/a (not charged)" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##")
cell(int r, string k, string v, color vc) =>
    table.cell(board, 0, r, k, text_color=color.new(color.gray, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(board, 1, r, v, text_color=vc, text_size=size.small, text_halign=text.align_right)

if showBoard and barstate.islast
    okC  = color.new(color.green, 0)
    badC = color.new(color.red, 0)
    neuC = color.new(color.white, 0)
    cell(0, "FX NEXT v5", tfOK ? (is1h ? "1h → 4h parent" : is4h ? "4h → D parent" : "D1 → W parent") : "timeframe not traded (use 1h, 4h, D)", tfOK ? neuC : badC)
    cell(1, "Spread (pips) / ATR (pips)", str.tostring(spreadPips, "#.#") + " / " + str.tostring(atr / pip, "#.#"), neuC)
    cell(2, "Carry base−quote (% p.a.)", carryOK ? str.tostring(carry, "#.##") + "  (" + syminfo.basecurrency + " " + str.tostring(baseRate, "#.##") + " − " + syminfo.currency + " " + str.tostring(quoteRate, "#.##") + ")" : "n/a (no ECONOMICS rate)", neuC)
    cell(3, "Financing pips/night long / short", signed(finLongPips) + " / " + signed(finShortPips), carryOK ? neuC : color.new(color.gray, 0))
    cell(4, "Cost c long / short (cap " + str.tostring(costMax, "#.##") + ")", f3(cLong) + " / " + f3(cShort), costOKLong or costOKShort ? okC : badC)
    cell(5, "Break-even hit rate long / short (q=0.8)", pct(0.5 + cLong / (2 * kATR * 0.8)) + " / " + pct(0.5 + cShort / (2 * kATR * 0.8)), neuC)
    cell(6, "Score / HTF trend", str.tostring(score) + " / " + (htfTrend == 1 ? "up" : htfTrend == -1 ? "down" : "flat"), neuC)
    cell(7, "Entry window", timeOK ? "open" : (not sessOK ? "outside London/NY" : not relOK ? "release slot" : not rollOK ? "daily close/reopen" : "thin season"), timeOK ? okC : badC)
    cell(8, "Calls / open", str.tostring(nCalls) + " / " + str.tostring(array.size(oDir)), neuC)
    cell(9, "Barrier hits / time stops (q)", str.tostring(nResolved) + " / " + str.tostring(nTime) + "  (" + f3(q) + ")", neuC)
    cell(10, "Hit rate (Wilson 95% low)", pct(hitRate) + "  (" + pct(hitLow) + ")", not na(hitLow) and not na(pStar) and hitLow > pStar ? okC : neuC)
    cell(11, "Break-even on these calls p*", pct(pStar), neuC)
    cell(12, "Net expectancy / call (ATR)", f3(expectancy), not na(expectancy) and expectancy > 0 ? okC : badC)
    cell(13, "Verdict", not verdictReady ? "not enough calls (" + str.tostring(nClosed) + "/" + str.tostring(minCallsForVerdict) + ")" : edgeShown ? "edge shown ON THIS CHART ONLY" : "no edge shown", edgeShown ? okC : neuC)
    cell(14, "Note", "in-sample; proof is the walk-forward in Python", color.new(color.gray, 0))

alertcondition(longCall,  "FX NEXT long call",  "FX NEXT v5 long call on {{ticker}} {{interval}} at {{close}}")
alertcondition(shortCall, "FX NEXT short call", "FX NEXT v5 short call on {{ticker}} {{interval}} at {{close}}")
